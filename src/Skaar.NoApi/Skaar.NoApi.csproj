<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Skaar.NoApi</RootNamespace>
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>noapi</ToolCommandName>
        <Description>A local fake of any http api, serving files according to route manifests.</Description>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CA1822</NoWarn>
        <VersionPrefix>1.1.0</VersionPrefix>
        <Product>No Api</Product>
        <Authors>Skaar</Authors>
        <PackageTags>Mock Fake Stub Api Http Testing</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <RepositoryUrl>https://github.com/oyms/NoApi</RepositoryUrl>
        <PackageProjectUrl>https://github.com/oyms/NoApi</PackageProjectUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReleaseNotes>
            ---
            1.0.0: Initial release.
            1.1.0: OpenAPI documents: generate manifests, or serve them directly. Inline response bodies.
        </PackageReleaseNotes>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <Content Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" Pack="false" />
        <Content Update="schema.json" CopyToOutputDirectory="PreserveNewest" Pack="false" />
        <EmbeddedResource Include="schema.json" LogicalName="schema.json" />
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\resources\icon.png" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <!-- Not Microsoft.AspNetCore.Routing.Route -->
        <Using Include="Skaar.NoApi.Model.Route" Alias="Route" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Skaar.NoApi.Tests" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.OpenApi" Version="3.11.0" />
      <PackageReference Include="Microsoft.OpenApi.YamlReader" Version="3.11.0" />
    </ItemGroup>

</Project>
